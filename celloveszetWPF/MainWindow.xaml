        <Label Content="Lövés2:" HorizontalAlignment="Left" Height="25" Margin="562,118,0,0" VerticalAlignment="Top" Width="53"/>
        <Label Content="Lövés3:" HorizontalAlignment="Left" Height="25" Margin="562,167,0,0" VerticalAlignment="Top" Width="53"/>
        <Label Content="Lövés4:" HorizontalAlignment="Left" Height="27" Margin="562,217,0,0" VerticalAlignment="Top" Width="53"/>
        <TextBox x:Name="TextBox1" HorizontalAlignment="Left" Height="27" Margin="622,21,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="148"/>
