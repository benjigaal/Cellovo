        <Button x:Name="AddButton" Content="Hozzáad" HorizontalAlignment="Left" Height="33" Margin="572,273,0,0" VerticalAlignment="Top" Width="198" Click="AddButton_Click"/>
        <Button x:Name="SaveButton" Content="Mentés" HorizontalAlignment="Left" Height="34" Margin="572,331,0,0" VerticalAlignment="Top" Width="198" Click="SaveButton_Click"/>


